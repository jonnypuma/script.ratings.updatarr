msgctxt "#32010"
msgid "TMDb API key"
msgstr ""

msgctxt "#32011"
msgid "Create a free key at themoviedb.org/settings/api. When TMDbHelper is installed, a score it has already cached is used even if this key is empty. A key is needed for titles that are not in that cache. This product uses the TMDb API but is not endorsed or certified by TMDb."
msgstr ""

msgctxt "#32012"
msgid "OMDb API key"
msgstr ""

msgctxt "#32013"
msgid "OMDb requires an API key on every request: omdbapi.com/?apikey=[yourkey]&i=[IMDb id]. A free key allows 1,000 requests a day. The result adds Rotten Tomatoes critic and Metacritic scores. Without a key, OMDb is skipped."
msgstr ""

msgctxt "#32014"
msgid "Trakt client ID"
msgstr ""

msgctxt "#32015"
msgid "Optional. Paste the client ID from your own Trakt application. Public ratings do not use the Trakt Kodi addon, and the client secret is not used."
