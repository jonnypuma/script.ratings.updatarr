msgctxt "#32036"
msgid "Local IMDb database"
msgstr ""

msgctxt "#32037"
msgid "A provider. Uses the IMDb ratings and episode files stored on this device for IMDb scores. The files are downloaded about every 30 days, and you can download them now from this page. Personal, non-commercial use: https://developer.imdb.com/non-commercial-datasets. They are removed after the index is built. About 800 MB of free space is needed. OMDb is still used for Rotten Tomatoes and Metacritic when that provider is on."
msgstr ""

msgctxt "#32038"
msgid "Refresh IMDb data every (days)"
msgstr ""

msgctxt "#32039"
msgid "IMDb download user agent"
msgstr ""

msgctxt "#32040"
msgid "Leave this empty to use a browser user agent. IMDb refuses some other clients."
msgstr ""

msgctxt "#32041"
msgid "Minimum rating change"
msgstr ""

msgctxt "#32042"
msgid "Write a rating only when it moves by more than this amount. 0.2 is the default, so 8.0 to 8.1 stays as it is and 8.0 to 8.3 is written. Set 0 to write every fetched rating, even when the number is unchanged."
msgstr ""

